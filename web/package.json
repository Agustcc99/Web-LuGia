{
  "name": "landing-cliente",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && vite build --ssr src/paginas/servidor.jsx --outDir .ssr && node scripts/generar-paginas.mjs",
    "preview": "vite preview",
    "revisar": "eslint . && prettier --check \"src/**/*.{js,jsx}\" \"scripts/**\" \"pruebas/**\" \"*.js\"",
    "formatear": "prettier --write \"src/**/*.{js,jsx}\" \"scripts/**\" \"pruebas/**\" \"*.js\"",
    "probar": "node --test \"pruebas/unidad/*.test.js\" && playwright test"
  },
  "dependencies": {
    "gsap": "^3.13.0",
    "motion": "^12.43.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.65.0",
    "@tailwindcss/vite": "^4.1.0",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^9.39.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.1.0",
    "vite": "^6.0.0"
  }
}
